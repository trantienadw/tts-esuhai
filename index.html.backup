                    <h2 class="text-4xl font-bold mb-4">💰 Tính Thu Nhập Dự Kiến</h2>
                    <p class="text-xl opacity-90">Xem bạn có thể kiếm và tiết kiệm được bao nhiêu</p>
                </div>

                <div class="calculator-container">
                    <div class="calculator-inputs">
                        <div class="calculator-input-group">
                            <label>Chọn ngành nghề:</label>
                            <select id="calc-industry" class="calculator-select">
                                <option value="35-55">🏥 Kaigo (35-55 triệu)</option>
                                <option value="35-50">🏗️ Xây dựng (35-50 triệu)</option>
                                <option value="35-50">⚙️ Cơ khí (35-50 triệu)</option>
                                <option value="30-45">🐟 Thủy sản (30-45 triệu)</option>
                                <option value="32-48">🍱 Thực phẩm (32-48 triệu)</option>
                                <option value="30-45">🌾 Nông nghiệp (30-45 triệu)</option>
                            </select>
                        </div>

                        <div class="calculator-input-group">
                            <label>Làm thêm giờ (OT):</label>
                            <select id="calc-ot" class="calculator-select">
                                <option value="0">Không OT</option>
                                <option value="20">20 giờ/tháng (+6-10 triệu)</option>
                                <option value="40" selected>40 giờ/tháng (+12-20 triệu)</option>
                                <option value="60">60 giờ/tháng (+18-30 triệu)</option>
                            </select>
                        </div>

                        <div class="calculator-input-group">
                            <label>Thời gian làm việc:</label>
                            <select id="calc-years" class="calculator-select">
                                <option value="1">1 năm</option>
                                <option value="3" selected>3 năm</option>
                                <option value="5">5 năm</option>
                            </select>
                        </div>
                    </div>

                    <div class="calculator-results">
                        <div class="result-item">
                            <div class="result-label">Thu nhập/tháng:</div>
                            <div class="result-value" id="monthly-income">45 triệu VND</div>
                        </div>
                        <div class="result-item">
                            <div class="result-label">Thu nhập/năm:</div>
                            <div class="result-value" id="yearly-income">540 triệu VND</div>
                        </div>
                        <div class="result-item highlight">
                            <div class="result-label">Tiết kiệm được (60%):</div>
                            <div class="result-value" id="savings">324 triệu/năm</div>
                        </div>
                        <div class="result-item highlight">
                            <div class="result-label">Tổng tiết kiệm sau <span id="total-years">3</span> năm:</div>
                            <div class="result-value large" id="total-savings">~972 triệu VND</div>
                        </div>
                    </div>

                    <div class="calculator-benefits">
                        <p class="text-lg font-semibold mb-4">Với số tiền này, bạn có thể:</p>
                        <div class="benefits-list">
                            <div class="benefit-item">🏠 Mua nhà/đất (DP 30-50%)</div>
                            <div class="benefit-item">🚗 Mua xe hơi (Full)</div>
                            <div class="benefit-item">💼 Khởi nghiệp với vốn lớn</div>
                            <div class="benefit-item">🎓 Gửi con đi học tốt</div>
                        </div>
                    </div>

                    <div class="text-center mt-8">
                        <button class="btn-white-lg" onclick="scrollToForm()">

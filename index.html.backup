    <!-- Process Timeline -->
    <section class="py-20 bg-white">
        <div class="container mx-auto px-4">
            <div class="text-center mb-16">
                <span class="section-tag">Quy trình</span>
                <h2 class="section-title">4 Bước Đơn Giản Đến Nhật Bản</h2>
                <p class="section-subtitle">
                    Từ đăng ký đến bay sang Nhật - Tikme đồng hành từng bước
                </p>
            </div>

            <div class="timeline">
                <div class="timeline-item">
                    <div class="timeline-number">1</div>
                    <div class="timeline-content">
                        <h3 class="timeline-title">Đăng ký & Tư vấn</h3>
                        <p class="timeline-desc">
                            Điền form đăng ký → Tư vấn viên gọi lại trong 30 phút → Tư vấn 1-1 về chương trình, ngành nghề phù hợp
                        </p>
                        <div class="timeline-duration">⏱️ 1-3 ngày</div>
                    </div>
                </div>

                <div class="timeline-item">
                    <div class="timeline-number">2</div>
                    <div class="timeline-content">
                        <h3 class="timeline-title">Học tại Trường JPC</h3>
                        <p class="timeline-desc">
                            Tiếng Nhật N5 → N4 → N3 + Kỹ năng chuyên môn + Văn hóa Nhật Bản. Giáo viên người Nhật, cơ sở hiện đại.
                        </p>
                        <div class="timeline-duration">⏱️ 6-12 tháng</div>
                    </div>
                </div>

                <div class="timeline-item">
                    <div class="timeline-number">3</div>
                    <div class="timeline-content">
                        <h3 class="timeline-title">Phỏng vấn Doanh nghiệp</h3>
                        <p class="timeline-desc">
                            Phỏng vấn online/offline với DN Nhật → Nhận thư mời làm việc (COE) → Hướng dẫn chuẩn bị hồ sơ visa
                        </p>
                        <div class="timeline-duration">⏱️ 1-2 tháng</div>
                    </div>
                </div>

                <div class="timeline-item">
                    <div class="timeline-number">4</div>
                    <div class="timeline-content">
                        <h3 class="timeline-title">Làm Visa & Bay Nhật</h3>
                        <p class="timeline-desc">
                            Nộp hồ sơ xin visa → Nhận visa → Đặt vé máy bay → Bay sang Nhật → DN đón tại sân bay → Bắt đầu làm việc
                        </p>
                        <div class="timeline-duration">⏱️ 2-3 tháng</div>
                    </div>
                </div>
            </div>

            <div class="process-summary">
                <div class="summary-card">
                    <div class="summary-icon">⏱️</div>
                    <div class="summary-text">
                        <div class="summary-label">Tổng thời gian</div>
                        <div class="summary-value">8-18 tháng</div>
                    </div>
                </div>
                <div class="summary-card">
                    <div class="summary-icon">📅</div>
                    <div class="summary-text">
                        <div class="summary-label">Đợt tuyển mới</div>
                        <div class="summary-value">Tháng 1-4/2026</div>
                    </div>
                </div>
                <div class="summary-card">
                    <div class="summary-icon">🎯</div>
                    <div class="summary-text">
                        <div class="summary-label">Tỷ lệ thành công</div>
                        <div class="summary-value">98%</div>
                    </div>
                </div>
            </div>
        </div>
    </section>


<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Chương trình Thực tập sinh Nhật Bản - Thu nhập 30-55 triệu/tháng. Không cần kinh nghiệm, đào tạo miễn phí, cam kết việc làm 100%.">
    <meta name="keywords" content="thực tập sinh nhật bản, TTS nhật, tokutei ginou, đi nhật, làm việc nhật bản">
    
    <!-- Open Graph -->
    <meta property="og:title" content="Thực tập sinh Nhật Bản - Thu nhập 30-55 triệu/tháng">
    <meta property="og:description" content="18,000+ người đã thành công. Không cần kinh nghiệm. Đăng ký ngay!">
    <meta property="og:type" content="website">
    
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: '#0066FF',
                        secondary: '#FF0000',
                        accent: '#00C48C',
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    },
                }
            }
        }
    </script>
    
    <!-- Custom CSS -->
    <link rel="stylesheet" href="tts-landing.css">
    
    <title>Thực Tập Sinh Nhật Bản 2026 - Thu nhập 30-55 triệu/tháng | Tikme</title>
</head>
<body class="font-sans antialiased">

    <!-- Sticky Header -->
    <header class="sticky-header">
        <div class="container mx-auto px-4">
            <div class="flex items-center justify-between h-16">
                <div class="flex items-center gap-2">
                    <span class="text-2xl font-bold text-primary">Tikme</span>
                    <span class="hidden sm:inline text-sm text-gray-600">Japan Jobs</span>
                </div>
                <div class="flex items-center gap-4">
                    <a href="tel:0906666222" class="hidden md:flex items-center gap-2 text-gray-700 hover:text-primary transition-colors">
                        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                            <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"/>
                        </svg>
                        <span class="font-semibold">090-6666-222</span>
                    </a>
                    <a href="#form" class="btn-primary">Đăng ký ngay</a>
                </div>
            </div>
        </div>
    </header>

    <!-- Hero Section -->
    <section class="hero-section">
        <div class="hero-background"></div>
        <div class="container mx-auto px-4 py-20 relative z-10">
            <div class="grid lg:grid-cols-2 gap-12 items-center">
                <!-- Left Column - Content -->
                <div class="text-white">
                    <!-- Urgency Banner -->
                    <div class="urgency-banner mb-6">
                        <span class="urgency-badge">🔥 HOT</span>
                        <span>Tuyển sinh đợt 1/2026 - Ưu đãi 20%</span>
                        <span class="countdown">Còn 87 suất</span>
                    </div>

                    <!-- Main Headline -->
                    <h1 class="hero-title">
                        Làm Thực Tập Sinh <br>
                        <span class="highlight">Nhật Bản 2026</span>
                    </h1>

                    <!-- Subheadline -->
                    <p class="hero-subtitle">
                        Thu nhập <strong>30-55 triệu/tháng</strong> - Gấp 3-5 lần Việt Nam<br>
                        Không cần kinh nghiệm • Đào tạo miễn phí • Cam kết việc làm 100%
                    </p>

                    <!-- USPs -->
                    <div class="hero-features">
                        <div class="feature-check">
                            <svg class="w-6 h-6 text-accent" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                            </svg>
                            <span>Không cần kinh nghiệm</span>
                        </div>
                        <div class="feature-check">
                            <svg class="w-6 h-6 text-accent" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                            </svg>
                            <span>Tiếng Nhật + Kỹ năng miễn phí</span>
                        </div>
                        <div class="feature-check">
                            <svg class="w-6 h-6 text-accent" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                            </svg>
                            <span>Hỗ trợ trả góp 0% lãi suất</span>
                        </div>
                    </div>

                    <!-- Social Proof -->
                    <div class="hero-stats">
                        <div class="stat-item">
                            <div class="stat-value">18,000+</div>
                            <div class="stat-label">Người thành công</div>
                        </div>
                        <div class="stat-item">
                            <div class="stat-value">20+</div>
                            <div class="stat-label">Năm kinh nghiệm</div>
                        </div>
                        <div class="stat-item">
                            <div class="stat-value">98%</div>
                            <div class="stat-label">Tỷ lệ hài lòng</div>
                        </div>
                    </div>
                </div>

                <!-- Right Column - Form -->
                <div class="form-container" id="form">
                    <div class="form-header">
                        <h2>📞 Đăng Ký Tư Vấn Miễn Phí</h2>
                        <p>Nhận tư vấn 1-1 từ chuyên gia. Gọi lại trong 30 phút!</p>
                    </div>
                    
                    <form id="lead-form" class="space-y-4">
                        <div>
                            <label class="form-label">Họ và tên *</label>
                            <input type="text" 
                                   name="name" 
                                   class="form-input" 
                                   placeholder="VD: Nguyễn Văn A"
                                   required>
                        </div>

                        <div>
                            <label class="form-label">Số điện thoại *</label>
                            <input type="tel" 
                                   name="phone" 
                                   class="form-input" 
                                   placeholder="VD: 0901234567"
                                   pattern="[0-9]{10}"
                                   required>
                        </div>

                        <div>
                            <label class="form-label">Chương trình quan tâm *</label>
                            <select name="program" class="form-input" required>
                                <option value="">-- Chọn chương trình --</option>
                                <option value="tts-1">TTS 1 năm (Phổ thông)</option>
                                <option value="tts-3">TTS 3 năm (Khuyến nghị)</option>
                                <option value="tokutei">Tokutei Ginou (Định cư)</option>
                                <option value="chua-quyet-dinh">Chưa quyết định</option>
                            </select>
                        </div>

                        <div>
                            <label class="form-label">Ngành nghề ưu tiên (Optional)</label>
                            <select name="industry" class="form-input">
                                <option value="">-- Chọn ngành --</option>
                                <option value="kaigo">🏥 Kaigo (Điều dưỡng)</option>
                                <option value="xay-dung">🏗️ Xây dựng</option>
                                <option value="co-khi">⚙️ Cơ khí</option>
                                <option value="thuy-san">🐟 Thủy sản</option>
                                <option value="thuc-pham">🍱 Thực phẩm</option>
                                <option value="nong-nghiep">🌾 Nông nghiệp</option>
                                <option value="oto">🚗 Ô tô</option>
                                <option value="dien-tu">🏭 Điện tử</option>
                                <option value="det-may">🧵 Dệt may</option>
                                <option value="logistics">📦 Logistics</option>
                                <option value="hospitality">🏨 Hospitality</option>
                                <option value="go-noi-that">🎨 Gỗ/Nội thất</option>
                            </select>
                        </div>

                        <button type="submit" class="btn-submit">
                            <span>Đăng ký tư vấn ngay</span>
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
                            </svg>
                        </button>

                        <div class="form-footer">
                            <svg class="w-5 h-5 text-accent" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M2.166 4.999A11.954 11.954 0 0010 1.944 11.954 11.954 0 0017.834 5c.11.65.166 1.32.166 2.001 0 5.225-3.34 9.67-8 11.317C5.34 16.67 2 12.225 2 7c0-.682.057-1.35.166-2.001zm11.541 3.708a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                            </svg>
                            <span>Cam kết bảo mật thông tin 100%</span>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </section>

    <!-- Trust Badges -->
    <section class="py-8 bg-white border-y">
        <div class="container mx-auto px-4">
            <p class="text-center text-sm text-gray-600 mb-6">Đối tác doanh nghiệp Nhật Bản tin tưởng</p>
            <div class="flex flex-wrap items-center justify-center gap-8 md:gap-12">
                <div class="trust-logo">Toyota</div>
                <div class="trust-logo">Honda</div>
                <div class="trust-logo">Panasonic</div>
                <div class="trust-logo">Sony</div>
                <div class="trust-logo">Denso</div>
                <div class="trust-logo">Toshiba</div>
            </div>
        </div>
    </section>

    <!-- Benefits Section -->
    <section class="py-20 bg-gradient-to-b from-white to-gray-50">
        <div class="container mx-auto px-4">
            <div class="text-center mb-16">
                <span class="section-tag">Lợi ích</span>
                <h2 class="section-title">Tại sao chọn Thực tập sinh Nhật Bản?</h2>
                <p class="section-subtitle">
                    Không chỉ là thu nhập cao - mà là đầu tư cho tương lai vững chắc
                </p>
            </div>

            <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
                <!-- Benefit 1 -->
                <div class="benefit-card">
                    <div class="benefit-icon">💰</div>
                    <h3 class="benefit-title">Thu nhập Vượt trội</h3>
                    <div class="benefit-value">30-55 triệu/tháng</div>
                    <p class="benefit-desc">
                        Gấp 3-5 lần so với Việt Nam. Chưa tính OT có thể thêm 30-50%.
                    </p>
                    <div class="benefit-comparison">
                        <div class="comparison-row">
                            <span>🇻🇳 VN:</span>
                            <span class="text-gray-600">7-12 triệu</span>
                        </div>
                        <div class="comparison-arrow">→</div>
                        <div class="comparison-row">
                            <span>🇯🇵 JP:</span>
                            <span class="font-bold text-accent">30-55 triệu</span>
                        </div>
                    </div>
                </div>

                <!-- Benefit 2 -->
                <div class="benefit-card">
                    <div class="benefit-icon">🎓</div>
                    <h3 class="benefit-title">Đào tạo Miễn phí</h3>
                    <div class="benefit-value">100% Chi phí</div>
                    <p class="benefit-desc">
                        Tiếng Nhật N5-N3 + Kỹ năng nghề tại Trường JPC. Giá trị 50-80 triệu.
                    </p>
                    <div class="space-y-2 mt-4">
                        <div class="feature-item">✓ Tiếng Nhật 6-12 tháng</div>
                        <div class="feature-item">✓ Kỹ năng chuyên môn</div>
                        <div class="feature-item">✓ Văn hóa Nhật Bản</div>
                    </div>
                </div>

                <!-- Benefit 3 -->
                <div class="benefit-card">
                    <div class="benefit-icon">🏆</div>
                    <h3 class="benefit-title">Cam kết 100%</h3>
                    <div class="benefit-value">Hoàn học phí</div>
                    <p class="benefit-desc">
                        Không đi được Nhật = Hoàn toàn bộ chi phí. Cam kết bằng văn bản.
                    </p>
                    <div class="space-y-2 mt-4">
                        <div class="feature-item">✓ 98% đi thành công</div>
                        <div class="feature-item">✓ Hỗ trợ đến khi bay</div>
                        <div class="feature-item">✓ Bảo lãnh pháp lý</div>
                    </div>
                </div>

                <!-- Benefit 4 -->
                <div class="benefit-card">
                    <div class="benefit-icon">💳</div>
                    <h3 class="benefit-title">Trả góp 0% lãi</h3>
                    <div class="benefit-value">Linh hoạt</div>
                    <p class="benefit-desc">
                        Nhiều gói thanh toán. Hỗ trợ vay ngân hàng. Trả theo tiến độ học.
                    </p>
                    <div class="space-y-2 mt-4">
                        <div class="feature-item">✓ Trả trước 30-50%</div>
                        <div class="feature-item">✓ Góp theo tháng</div>
                        <div class="feature-item">✓ Hỗ trợ vay NH</div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Programs Comparison -->
    <section class="py-20 bg-white">
        <div class="container mx-auto px-4">
            <div class="text-center mb-16">
                <span class="section-tag">Chương trình</span>
                <h2 class="section-title">3 Chương trình Thực tập sinh</h2>
                <p class="section-subtitle">
                    Chọn chương trình phù hợp với mục tiêu và hoàn cảnh của bạn
                </p>
            </div>

            <!-- Programs Grid -->
            <div class="grid md:grid-cols-3 gap-8 mb-12">
                <!-- TTS 1 Year -->
                <div class="program-card">
                    <div class="program-badge">Phổ thông</div>
                    <div class="program-header">
                        <h3 class="program-title">TTS 1 Năm</h3>
                        <div class="program-price">24-50 triệu</div>
                        <p class="program-desc">Phù hợp người mới, thử nghiệm</p>
                    </div>
                    <div class="program-features">
                        <div class="program-feature">
                            <svg class="w-5 h-5 text-accent" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                            </svg>
                            <span>Thời hạn: 1 năm</span>
                        </div>
                        <div class="program-feature">
                            <svg class="w-5 h-5 text-accent" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                            </svg>
                            <span>Lương: 30-45 triệu/tháng</span>
                        </div>
                        <div class="program-feature">
                            <svg class="w-5 h-5 text-accent" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                            </svg>
                            <span>Độ tuổi: 18-30</span>
                        </div>
                        <div class="program-feature">
                            <svg class="w-5 h-5 text-gray-400" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
                            </svg>
                            <span class="text-gray-400">Không đưa gia đình</span>
                        </div>
                        <div class="program-feature">
                            <svg class="w-5 h-5 text-gray-400" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
                            </svg>
                            <span class="text-gray-400">Khó định cư</span>
                        </div>
                    </div>
                    <button class="program-btn" onclick="selectProgram('tts-1')">Chọn chương trình</button>
                </div>

                <!-- TTS 3 Years - RECOMMENDED -->
                <div class="program-card recommended">
                    <div class="program-badge recommended">✨ Khuyến nghị</div>
                    <div class="program-header">
                        <h3 class="program-title">TTS 3 Năm</h3>
                        <div class="program-price">50 triệu</div>
                        <p class="program-desc">Tốt nhất - Cân bằng chi phí/lợi ích</p>
                    </div>
                    <div class="program-features">
                        <div class="program-feature">
                            <svg class="w-5 h-5 text-accent" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                            </svg>
                            <span>Thời hạn: 3 năm</span>
                        </div>
                        <div class="program-feature">
                            <svg class="w-5 h-5 text-accent" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                            </svg>
                            <span>Lương: 35-50 triệu/tháng</span>
                        </div>
                        <div class="program-feature">
                            <svg class="w-5 h-5 text-accent" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                            </svg>
                            <span>Độ tuổi: 18-30</span>
                        </div>
                        <div class="program-feature">
                            <svg class="w-5 h-5 text-accent" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                            </svg>
                            <span>Tiết kiệm ~900 triệu</span>
                        </div>
                        <div class="program-feature">
                            <svg class="w-5 h-5 text-accent" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                            </svg>
                            <span>Có thể chuyển Tokutei</span>
                        </div>
                    </div>
                    <button class="program-btn recommended" onclick="selectProgram('tts-3')">Chọn chương trình</button>
                </div>

                <!-- Tokutei Ginou -->
                <div class="program-card">
                    <div class="program-badge premium">VIP</div>
                    <div class="program-header">
                        <h3 class="program-title">Tokutei Ginou</h3>
                        <div class="program-price">39-109 triệu</div>
                        <p class="program-desc">Định cư dài hạn, đưa gia đình</p>
                    </div>
                    <div class="program-features">
                        <div class="program-feature">
                            <svg class="w-5 h-5 text-accent" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                            </svg>
                            <span>Thời hạn: 5 năm+</span>
                        </div>
                        <div class="program-feature">
                            <svg class="w-5 h-5 text-accent" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                            </svg>
                            <span>Lương: 40-55 triệu/tháng</span>
                        </div>

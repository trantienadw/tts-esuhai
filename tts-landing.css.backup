/* =========================================
   TIKME TTS LANDING PAGE - CSS
   Comprehensive styling for all components
   ========================================= */

/* ============ CSS VARIABLES ============ */
:root {
    --primary: #0066FF;
    --primary-dark: #0052CC;
    --secondary: #FF0000;
    --accent: #00C48C;
    --gray-50: #F8F9FA;
    --gray-100: #F1F3F5;
    --gray-200: #E9ECEF;
    --gray-300: #DEE2E6;
    --gray-400: #CED4DA;
    --gray-500: #ADB5BD;
    --gray-600: #6C757D;
    --gray-700: #495057;
    --gray-800: #343A40;
    --gray-900: #212529;
    
    --radius-sm: 0.375rem;
    --radius-md: 0.5rem;
    --radius-lg: 0.75rem;
    --radius-xl: 1rem;
    --radius-2xl: 1.5rem;
    
    --shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
    --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
    --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
    --shadow-xl: 0 20px 25px -5px rgba(0, 0, 0, 0.1);
}

/* ============ RESET & BASE ============ */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    font-size: 16px;
    line-height: 1.6;
    color: var(--gray-900);
    background: white;
}

/* ============ STICKY HEADER ============ */
.sticky-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    background: white;
    box-shadow: var(--shadow-md);
    z-index: 1000;
    transition: all 0.3s ease;
}

/* ============ BUTTONS ============ */
.btn-primary,
.btn-primary-lg,
.btn-white-lg {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.75rem 1.5rem;
    font-weight: 600;
    border-radius: var(--radius-md);
    border: none;
    cursor: pointer;
    transition: all 0.2s ease;
    text-decoration: none;
}

.btn-primary {
    background: var(--primary);
    color: white;
    padding: 0.625rem 1.25rem;
    font-size: 0.875rem;
}

.btn-primary:hover {
    background: var(--primary-dark);
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(0, 102, 255, 0.3);
}

.btn-primary-lg {
    background: var(--primary);
    color: white;
    padding: 1rem 2rem;
    font-size: 1.125rem;
    border-radius: var(--radius-lg);
}

.btn-primary-lg:hover {
    background: var(--primary-dark);
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(0, 102, 255, 0.4);
}

.btn-white-lg {
    background: white;
    color: var(--primary);
    padding: 1rem 2rem;
    font-size: 1.125rem;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
}

.btn-white-lg:hover {
    background: var(--gray-50);
    transform: translateY(-2px);
    box-shadow: var(--shadow-xl);
}

/* ============ HERO SECTION ============ */
.hero-section {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding: 120px 0 80px;
    overflow: hidden;
}

.hero-background {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    z-index: 0;
}

.hero-background::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-image: 
        radial-gradient(circle at 20% 50%, rgba(102, 126, 234, 0.3) 0%, transparent 50%),
        radial-gradient(circle at 80% 80%, rgba(118, 75, 162, 0.3) 0%, transparent 50%);
}

.urgency-banner {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    padding: 0.5rem 1.5rem;
    background: rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(10px);
    border-radius: var(--radius-2xl);
    font-size: 0.875rem;
    font-weight: 600;
    animation: pulse 2s ease-in-out infinite;
}

.urgency-badge {
    padding: 4px 8px;
    background: rgba(255, 107, 53, 0.9);
    border-radius: var(--radius-sm);
}

.countdown {
    padding: 4px 12px;
    background: rgba(0, 0, 0, 0.3);
    border-radius: var(--radius-sm);
}

.hero-title {
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 900;
    line-height: 1.1;
    margin-bottom: 1.5rem;
}

.hero-title .highlight {
    background: linear-gradient(135deg, #FFD700 0%, #FFA500 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
}

.hero-subtitle {
    font-size: 1.25rem;
    line-height: 1.6;
    margin-bottom: 2rem;
    opacity: 0.95;
}

.hero-features {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 2rem;
}

.feature-check {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 1rem;
    font-weight: 500;
}

.hero-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    margin-top: 3rem;
}

.stat-item {
    text-align: center;
}

.stat-value {
    font-size: 2rem;
    font-weight: 800;
    line-height: 1;
    margin-bottom: 0.5rem;
}

.stat-label {
    font-size: 0.875rem;
    opacity: 0.9;
}

/* ============ FORM CONTAINER ============ */
.form-container {
    background: white;
    border-radius: var(--radius-2xl);
    padding: 2rem;
    box-shadow: var(--shadow-xl);
}

.form-header {
    text-align: center;
    margin-bottom: 2rem;
}

.form-header h2 {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--gray-900);
    margin-bottom: 0.5rem;
}

.form-header p {
    color: var(--gray-600);
    font-size: 0.875rem;
}

.form-label {
    display: block;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--gray-700);
    margin-bottom: 0.5rem;
}

.form-input {
    width: 100%;
    padding: 0.75rem 1rem;
    font-size: 1rem;
    color: var(--gray-900);
    background: white;
    border: 1px solid var(--gray-300);
    border-radius: var(--radius-md);
    transition: all 0.2s ease;
}

.form-input:focus {
    outline: none;
    border-color: var(--primary);
    box-shadow: 0 0 0 3px rgba(0, 102, 255, 0.1);
}

.btn-submit {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 1rem;
    background: var(--primary);
    color: white;
    font-size: 1rem;
    font-weight: 700;
    border: none;
    border-radius: var(--radius-md);
    cursor: pointer;
    transition: all 0.2s ease;
}

.btn-submit:hover {
    background: var(--primary-dark);
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(0, 102, 255, 0.3);
}

.form-footer {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 1rem;
    font-size: 0.75rem;
    color: var(--gray-600);
}

/* ============ TRUST LOGOS ============ */
.trust-logo {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--gray-400);
    transition: color 0.2s ease;
}

.trust-logo:hover {
    color: var(--gray-600);
}

/* ============ SECTIONS ============ */
.section-tag {
    display: inline-block;
    padding: 0.375rem 1rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--primary);
    background: rgba(0, 102, 255, 0.1);
    border-radius: var(--radius-2xl);
    margin-bottom: 1rem;
}

.section-title {
    font-size: clamp(2rem, 4vw, 2.5rem);
    font-weight: 800;
    margin-bottom: 1rem;
    color: var(--gray-900);
}

.section-subtitle {
    font-size: 1.125rem;
    color: var(--gray-600);
    max-width: 700px;
    margin: 0 auto;
}

/* ============ BENEFITS CARDS ============ */
.benefit-card {
    background: white;
    border-radius: var(--radius-xl);
    padding: 2rem;
    box-shadow: var(--shadow-md);
    transition: all 0.3s ease;
}

.benefit-card:hover {
    transform: translateY(-8px);
    box-shadow: var(--shadow-xl);
}

.benefit-icon {
    font-size: 3rem;
    margin-bottom: 1rem;
}

.benefit-title {
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
}

.benefit-value {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--primary);
    margin-bottom: 1rem;
}

.benefit-desc {
    color: var(--gray-600);
    margin-bottom: 1.5rem;
}

.benefit-comparison {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
}

.comparison-row {
    display: flex;
    justify-content: space-between;
    padding: 0.5rem;
    background: var(--gray-50);
    border-radius: var(--radius-sm);
}

.comparison-arrow {
    text-align: center;
    color: var(--primary);
    font-weight: 700;
    font-size: 1.5rem;
}

.feature-item {
    font-size: 0.875rem;
    color: var(--gray-700);
}

.feature-item::before {
    content: '✓ ';
    color: var(--accent);
    font-weight: 700;
}

/* ============ PROGRAM CARDS ============ */
.program-card {
    position: relative;
    background: white;
    border: 2px solid var(--gray-200);
    border-radius: var(--radius-xl);
    padding: 2rem;
    transition: all 0.3s ease;
}

.program-card:hover {
    border-color: var(--primary);
    transform: translateY(-4px);
    box-shadow: var(--shadow-xl);
}

.program-card.recommended {
    border-color: var(--primary);
    border-width: 3px;
    box-shadow: 0 0 0 4px rgba(0, 102, 255, 0.1);
}

.program-badge {
    position: absolute;
    top: -12px;
    left: 50%;
    transform: translateX(-50%);
    padding: 0.375rem 1rem;
    font-size: 0.75rem;
    font-weight: 700;
    background: var(--gray-200);
    color: var(--gray-700);
    border-radius: var(--radius-2xl);
    white-space: nowrap;
}

.program-badge.recommended {
    background: var(--primary);
    color: white;
}

.program-badge.premium {
    background: linear-gradient(135deg, #FFD700 0%, #FFA500 100%);
    color: white;
}

.program-header {
    text-align: center;
    margin-bottom: 2rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--gray-200);
}

.program-title {
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: 1rem;
}

.program-price {
    font-size: 2rem;
    font-weight: 800;
    color: var(--primary);
    margin-bottom: 0.5rem;
}

.program-desc {
    color: var(--gray-600);
    font-size: 0.875rem;
}

.program-features {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 2rem;
}

.program-feature {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.875rem;
}

.program-btn {
    width: 100%;
    padding: 1rem;
    background: var(--gray-100);
    color: var(--gray-900);
    font-weight: 700;
    border: 2px solid var(--gray-300);
    border-radius: var(--radius-md);
    cursor: pointer;
    transition: all 0.2s ease;
}

.program-btn:hover {
    background: var(--gray-200);
    border-color: var(--gray-400);
}

.program-btn.recommended {
    background: var(--primary);
    color: white;
    border-color: var(--primary);
}

.program-btn.recommended:hover {
    background: var(--primary-dark);
}

/* ============ COMPARISON TABLE ============ */
.comparison-table-container {
    overflow-x: auto;
    margin-top: 3rem;
}

.comparison-table {
    width: 100%;
    border-collapse: collapse;
    background: white;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-md);
}

.comparison-table th,
.comparison-table td {
    padding: 1rem;
    text-align: center;
    border: 1px solid var(--gray-200);
}

.comparison-table th {
    background: var(--gray-100);
    font-weight: 700;
    color: var(--gray-900);
}

.recommended-col {
    background: rgba(0, 102, 255, 0.05);
    font-weight: 600;
}

/* ============ INDUSTRIES GRID ============ */
.industry-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: center;
    margin-bottom: 3rem;
}

.filter-btn {
    padding: 0.75rem 1.5rem;
    background: white;
    color: var(--gray-700);
    font-weight: 600;
    border: 2px solid var(--gray-300);
    border-radius: var(--radius-2xl);
    cursor: pointer;
    transition: all 0.2s ease;
}

.filter-btn:hover,
.filter-btn.active {
    background: var(--primary);
    color: white;
    border-color: var(--primary);
}

.industries-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 2rem;
}

.industry-card {
    position: relative;
    background: white;
    border-radius: var(--radius-xl);
    padding: 2rem;
    text-align: center;
    box-shadow: var(--shadow-md);
    transition: all 0.3s ease;
}

.industry-card:hover {
    transform: translateY(-8px);
    box-shadow: var(--shadow-xl);
}

.industry-badge {
    position: absolute;
    top: 1rem;
    right: 1rem;
    padding: 0.25rem 0.75rem;
    font-size: 0.75rem;
    font-weight: 700;
    background: var(--gray-200);
    color: var(--gray-700);
    border-radius: var(--radius-sm);
}

.industry-badge.hot {
    background: linear-gradient(135deg, #FF6B35 0%, #FF8F6B 100%);
    color: white;
}

.industry-icon {
    font-size: 4rem;
    margin-bottom: 1rem;
}

.industry-name {
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
}

.industry-name span {
    font-size: 0.875rem;
    font-weight: 400;
    color: var(--gray-600);
}

.industry-salary {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--accent);
    margin-bottom: 0.5rem;
}

.industry-rating {
    margin-bottom: 1rem;
    color: #FFD700;
}

.industry-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    justify-content: center;
    margin-bottom: 1.5rem;
}

.tag {
    padding: 0.25rem 0.75rem;
    font-size: 0.75rem;
    background: var(--gray-100);
    color: var(--gray-700);
    border-radius: var(--radius-sm);
}

.industry-btn {
    width: 100%;
    padding: 0.75rem;
    background: var(--primary);
    color: white;
    font-weight: 600;
    border: none;
    border-radius: var(--radius-md);
    cursor: pointer;
    transition: all 0.2s ease;
}

.industry-btn:hover {
    background: var(--primary-dark);
}

/* ============ CALCULATOR ============ */
.calculator-container {
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(10px);
    border-radius: var(--radius-xl);
    padding: 2rem;
    border: 1px solid rgba(255, 255, 255, 0.2);
}

.calculator-inputs {
    display: grid;
    gap: 1.5rem;
    margin-bottom: 2rem;
}

.calculator-input-group label {
    display: block;
    font-weight: 600;
    margin-bottom: 0.5rem;
}

.calculator-select {
    width: 100%;
    padding: 0.75rem 1rem;
    font-size: 1rem;
    background: white;
    color: var(--gray-900);
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: var(--radius-md);
}

.calculator-results {
    display: grid;
    gap: 1rem;
    margin-bottom: 2rem;
}

.result-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem;
    background: rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-md);
}

.result-item.highlight {
    background: rgba(0, 196, 140, 0.2);
    border: 2px solid var(--accent);
}

.result-label {
    font-size: 0.875rem;
}

.result-value {
    font-size: 1.25rem;
    font-weight: 800;
}

.result-value.large {
    font-size: 2rem;
}

.calculator-benefits {
    text-align: center;
    margin-bottom: 2rem;
}

.benefits-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1rem;
    margin-top: 1rem;
}

.benefit-item {
    padding: 1rem;
    background: rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-md);
    font-weight: 600;
}

/* ============ TIMELINE ============ */
.timeline {
    max-width: 800px;
    margin: 0 auto;
    position: relative;
}

.timeline::before {
    content: '';
    position: absolute;
    left: 2rem;
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--gray-300);
}

.timeline-item {
    position: relative;
    padding-left: 5rem;
    margin-bottom: 3rem;
}

.timeline-number {
    position: absolute;
    left: 0;
    width: 4rem;
    height: 4rem;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    font-weight: 800;
    background: var(--primary);
    color: white;
    border-radius: 50%;
    box-shadow: 0 0 0 4px white, 0 0 0 8px var(--primary);
}

.timeline-content {
    background: white;
    padding: 1.5rem;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
}

.timeline-title {
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
}

.timeline-desc {
    color: var(--gray-600);
    margin-bottom: 1rem;
}

.timeline-duration {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    background: var(--gray-100);
    color: var(--gray-700);
    font-size: 0.875rem;
    font-weight: 600;
    border-radius: var(--radius-sm);
}

.process-summary {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 2rem;
    margin-top: 4rem;
}

.summary-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.5rem;
    background: white;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
}

.summary-icon {
    font-size: 2.5rem;
}

.summary-label {
    font-size: 0.875rem;
    color: var(--gray-600);
}

.summary-value {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--primary);
}

/* ============ SUCCESS STORIES ============ */
.success-story-card {
    background: white;
    border-radius: var(--radius-xl);
    padding: 2rem;
    text-align: center;
    box-shadow: var(--shadow-md);
    transition: all 0.3s ease;
}

.success-story-card:hover {
    transform: translateY(-8px);
    box-shadow: var(--shadow-xl);
}

.story-avatar {
    width: 80px;
    height: 80px;
    margin: 0 auto 1rem;
}

.avatar-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 3rem;
    background: var(--gray-100);
    border-radius: 50%;
}

.story-name {
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: 0.25rem;
}

.story-info {
    color: var(--gray-600);
    font-size: 0.875rem;
    margin-bottom: 0.5rem;
}

.story-rating {
    margin-bottom: 1rem;
    color: #FFD700;
}

.story-quote {
    font-style: italic;
    color: var(--gray-700);
    margin-bottom: 1.5rem;
}

.story-stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--gray-200);
}

.stat {
    text-align: center;
}

.stat .stat-value {
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--accent);
}

.stat .stat-label {
    font-size: 0.75rem;
    color: var(--gray-600);
}

/* ============ FAQ ACCORDION ============ */
.faq-accordion {
    display: flex;
    flex-direction: column;
    gap: 1rem;
}

.faq-item {
    background: white;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
}

.faq-question {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem;
    background: none;
    border: none;
    font-size: 1rem;
    font-weight: 600;
    text-align: left;
    cursor: pointer;
    transition: background 0.2s ease;
}

.faq-question:hover {
    background: var(--gray-50);
}

.faq-icon {
    width: 1.5rem;
    height: 1.5rem;
    flex-shrink: 0;
    transition: transform 0.3s ease;
}

.faq-item.active .faq-icon {
    transform: rotate(180deg);
}

.faq-answer {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease;
}

.faq-item.active .faq-answer {
    max-height: 1000px;
}

.faq-answer p,
.faq-answer ul {
    padding: 0 1.25rem 1.25rem;
    color: var(--gray-700);
    line-height: 1.8;
}

.faq-answer ul {
    padding-left: 2.5rem;
}

/* ============ CTA SECTION ============ */
.cta-benefits {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    justify-content: center;
}

.cta-benefit {
    font-size: 1.125rem;
    font-weight: 600;
}

/* ============ FLOATING ACTIONS ============ */
.floating-actions {
    position: fixed;
    bottom: 2rem;
    right: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    z-index: 999;
}

.fab {
    width: 56px;
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    box-shadow: var(--shadow-lg);
    cursor: pointer;
    transition: all 0.3s ease;
    position: relative;
}

.fab:hover {
    transform: scale(1.1);
    box-shadow: var(--shadow-xl);
}

.fab.phone {
    background: var(--accent);
    color: white;
}

.fab.chat {
    background: var(--primary);
    color: white;
}

.fab.scroll-top {
    background: var(--gray-700);
    color: white;
}

.fab[data-tooltip]::before {
    content: attr(data-tooltip);
    position: absolute;
    right: calc(100% + 1rem);
    padding: 0.5rem 1rem;
    background: var(--gray-900);
    color: white;
    font-size: 0.875rem;
    white-space: nowrap;
    border-radius: var(--radius-md);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease;
}

.fab:hover[data-tooltip]::before {
    opacity: 1;
}

/* ============ MODALS ============ */
.modal-overlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.5);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 9999;
    padding: 1rem;
}

.modal-overlay.hidden {
    display: none;
}

.modal-content {
    position: relative;
    background: white;
    border-radius: var(--radius-xl);
    max-width: 600px;
    width: 100%;
    max-height: 90vh;
    overflow-y: auto;
    padding: 2rem;
}

.modal-close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    background: var(--gray-100);
    border: none;
    border-radius: 50%;
    cursor: pointer;
    transition: background 0.2s ease;
}

.modal-close:hover {
    background: var(--gray-200);
}

/* ============ ANIMATIONS ============ */
@keyframes pulse {
    0%, 100% {
        transform: scale(1);
    }
    50% {
        transform: scale(1.05);
    }
}

.pulse-animation {
    animation: pulse 2s ease-in-out infinite;
}

/* ============ RESPONSIVE ============ */
@media (max-width: 1024px) {
    .hero-stats {
        grid-template-columns: repeat(2, 1fr);
    }
}

@media (max-width: 768px) {
    .hero-section {
        padding: 100px 0 60px;
    }
    
    .hero-title {
        font-size: 2rem;
    }
    
    .hero-subtitle {
        font-size: 1rem;
    }
    
    .hero-stats {
        grid-template-columns: 1fr;
        gap: 1rem;
    }
    
    .form-container {
        padding: 1.5rem;
    }
    
    .industries-grid {
        grid-template-columns: 1fr;
    }
    
    .timeline::before {
        left: 1rem;
    }
    
    .timeline-item {
        padding-left: 4rem;
    }
    
    .timeline-number {
        width: 3rem;
        height: 3rem;
        font-size: 1.25rem;
    }
    
    .floating-actions {
        bottom: 1rem;
        right: 1rem;
    }
    
    .fab {
        width: 48px;
        height: 48px;
    }
}
